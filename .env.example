# 复制此文件为 .env 后填写（不要把 .env 提交到 git）

# LLM API Key - 如果不填，网站会自动降级到本地模板解读
LLM_API_KEY=

# LLM 接口地址 - 默认兼容 OpenAI 格式，可换成国内模型
# 例如硅基流动: https://api.siliconflow.cn/v1
# 例如豆包: https://ark.cn-beijing.volces.com/api/v3
# 例如通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.openai.com/v1

# 模型名称
LLM_MODEL=gpt-3.5-turbo

# 服务端口
PORT=3000
